# Cloudflare Pages _headers for boardduel (boardduel.com)
# 独立站点安全头。账号体系独立(不调用主站API)，connect-src 放行本域 + 本域 WS。

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com wss://boardduel.com wss://www.boardduel.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# HTML 不缓存（部署即时生效；旧 max-age=600 会让用户在部署后 10 分钟内拿到旧页面）
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# PWA manifest 短期缓存
/manifest*.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

# sitemap / llms / ai / robots 短缓存
/sitemap*.xml
  Cache-Control: public, max-age=3600
/llms*.txt
  Cache-Control: public, max-age=3600, must-revalidate
/ai.txt
  Cache-Control: public, max-age=3600, must-revalidate
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

# service-worker 永缓存控制
/service-worker.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /
